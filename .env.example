# ===========================================
# CortexResearch — Configuration
# ===========================================
# Copy this file to .env and fill in your values

# --- API Keys ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- LLM Settings (tiered) ---
# smart = research & report synthesis, fast = scoring & extraction
MODEL_NAME=claude-sonnet-5-5
MODEL_FAST=claude-haiku-4-5-20251001
TEMPERATURE=0.7
MAX_TOKENS_SMART=16384
MAX_TOKENS_FAST=2048

# --- Retrieval Settings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_INDEX_DIR=data/rag
RAG_RERANK=true
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Optional upgrades (all off by default; degrade gracefully) ---
ENABLE_GRAPH_RAG=false
GRAPH_WORKING_DIR=data/graphrag
ENABLE_SUPERMEMORY=false
SUPERMEMORY_URL=
SUPERMEMORY_API_KEY=

# --- Topic Watch ---
DB_PATH=data/cortex.db
WATCH_SOURCES=hackernews,arxiv,rss,reddit,github,producthunt
HN_MIN_SCORE=60
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL,cs.SE
REDDIT_SUBREDDITS=MachineLearning,LocalLLaMA,LLMDevs,startups
GITHUB_MIN_STARS=40
PREFILTER_K=80
LLM_SCORE_K=25
MIN_DISPLAY_SCORE=5.0

# --- Scheduler / digest ---
SCHEDULE_INTERVAL_MINUTES=240
DIGEST_HOUR=8
DIGEST_MIN_SCORE=6.0
DIGEST_MAX_ITEMS=12
DIGEST_DIR=data/digests
SLACK_WEBHOOK_URL=

# --- API Settings ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- System 1 / System 2 Routing (Jev) ---
# Fast calibrated decisions (ranking, claim checks, query classification)
# routed through Jev; low-confidence decisions escalate to the chat tier.
S1_ENABLED=true
# Your Jev early-access key — leave empty to use the local calibrated fallback.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-1
# S1 decisions below this confidence escalate to System 2 (chat tier).
S1_CONFIDENCE_THRESHOLD=0.75
S1_ESCALATION_TIER=fast

# --- Guardrails (Phase 2) ---
# Injection scanning + PII scrubbing + LLM I/O policy. All offline heuristics.
GUARDRAILS_ENABLED=true
GUARDRAILS_PII_ENABLED=true
GUARDRAILS_INJECTION_ENABLED=true
# Output check on every LLM call: monitor (log+record) | enforce (redact in place) | off
GUARDRAILS_LLM_OUTPUT=monitor
GUARDRAILS_S1_BORDERLINE=true
