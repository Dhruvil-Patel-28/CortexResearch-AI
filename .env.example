# ===========================================
# CortexResearch — Configuration
# ===========================================
# Copy this file to .env and fill in your values

# --- API Keys ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- LLM Settings (tiered) ---
# smart = research & report synthesis, fast = scoring & extraction
MODEL_NAME=claude-sonnet-5-5
MODEL_FAST=claude-haiku-4-5-20251001
TEMPERATURE=0.7
MAX_TOKENS_SMART=8192
MAX_TOKENS_FAST=2048

# --- RAG Settings ---
DATA_PATH=data
INDEX_PATH=faiss_index
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVER_K=4

# --- API Settings ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Memory Settings ---
MAX_MEMORY_TURNS=10

# --- Topic Watch ---
DB_PATH=data/cortex.db
WATCH_SOURCES=hackernews,arxiv,rss,reddit,github,producthunt
HN_MIN_SCORE=60
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL,cs.SE
REDDIT_SUBREDDITS=MachineLearning,LocalLLaMA,LLMDevs,startups
GITHUB_MIN_STARS=40
PREFILTER_K=80
LLM_SCORE_K=25
MIN_DISPLAY_SCORE=5.0
